---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const groups = [
  {
    title: 'Παιδικό Τμήμα',
    description: 'Εκμάθηση σαρακατσάνικων χορών για παιδιά, με σεβασμό στην αυθεντική μορφή.',
  },
  {
    title: 'Νεανικό / Εφήβων',
    description: 'Τμήμα για νέους χορευτές με εμπειρία σε παραδοσιακούς χορούς.',
  },
  {
    title: 'Ενηλίκων',
    description: 'Τμήμα ενηλίκων — διατήρηση και μετάδοση της σαρακατσάνικης χορευτικής παράδοσης.',
  },
];
---

<BaseLayout title="Χορευτικά">
  <PageHeader title="Χορευτικά" />
  <section class="section">
    <div class="container">
      <p class="prose">
        Τα χορευτικά τμήματα του συλλόγου μας εκπαιδεύουν μέλη κάθε ηλικίας στους
        σαρακατσάνικους χορούς, με σεβασμό στην αυθεντική μορφή και την παράδοση. Το
        χορευτικό συμμετέχει σταθερά στο Αντάμωμα στη Μπουζάλα, στον ετήσιο χορό του
        Συλλόγου, στο Πανελλήνιο Αντάμωμα στο Περτούλι και σε εκδηλώσεις της Καβάλας.
      </p>
      <div class="grid grid--3" style="margin-top: 2rem;">
        {
          groups.map((group) => (
            <div class="dance-group">
              <h3 class="dance-group__title">{group.title}</h3>
              <p class="dance-group__desc">{group.description}</p>
            </div>
          ))
        }
      </div>
      <div class="prose" style="margin-top: 2rem;">
        <h2>Προπονήσεις &amp; εγγραφές</h2>
        <p>
          Οι πρόβες των χορευτικών πραγματοποιούνται στον χώρο του Συλλόγου στη Νέα
          Κώμη Καβάλας. Όποιος και όποια αγαπά την παραδοσιακή μουσική και τον χορό,
          Σαρακατσάνος ή μη, ανεξαρτήτως ηλικίας, μπορεί να συμμετάσχει.
        </p>
        <p class="prose-note">
          Για τις τρέχουσες ημέρες και ώρες προπονήσεων και για εγγραφές,
          επικοινωνήστε μαζί μας ή παρακολουθήστε τη
          <a href="https://www.facebook.com/groups/58563429647/" target="_blank" rel="noopener noreferrer">σελίδα μας στο Facebook</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
