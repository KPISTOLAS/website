---
interface Props {
  message?: string;
}

const { message = 'Το περιεχόμενο θα προστεθεί σύντομα.' } = Astro.props;
---

<div class="placeholder">
  <svg class="placeholder__icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <rect x="8" y="12" width="32" height="24" rx="2" stroke="currentColor" stroke-width="2"></rect>
    <path d="M8 20h32" stroke="currentColor" stroke-width="2"></path>
    <circle cx="14" cy="16" r="2" fill="currentColor"></circle>
    <circle cx="20" cy="16" r="2" fill="currentColor"></circle>
  </svg>
  <p class="placeholder__text">{message}</p>
  <slot />
</div>
