---
import { site } from '../config/site';

const footerLinks = site.nav.flatMap((item) => {
  if (item.children) {
    return item.children.filter((c) => c.href).map((c) => ({ label: c.label, href: c.href! }));
  }
  if (item.href && item.href !== '/') {
    return [{ label: item.label, href: item.href }];
  }
  return [];
});
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <h3 class="site-footer__title">{site.shortName}</h3>
        <p>{site.name}</p>
        <p>{site.hours}</p>
      </div>

      <div>
        <h3 class="site-footer__title">Επικοινωνία</h3>
        <ul class="site-footer__list">
          <li>{site.contact.address}</li>
          <li>
            <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a>
          </li>
          {
            site.contact.mobile && (
              <li>
                <a href={`tel:${site.contact.mobile.replace(/\s/g, '')}`}>{site.contact.mobile}</a>
              </li>
            )
          }
          <li>
            {
              site.contact.email ? (
                <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
              ) : (
                'Email — προς συμπλήρωση'
              )
            }
          </li>
        </ul>
        {
          (site.social.facebook || site.social.youtube || site.social.blog) && (
            <div class="social-links">
              {site.social.facebook && (
                <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">
                  Facebook
                </a>
              )}
              {site.social.youtube && (
                <a href={site.social.youtube} target="_blank" rel="noopener noreferrer">
                  YouTube
                </a>
              )}
              {site.social.blog && (
                <a href={site.social.blog} target="_blank" rel="noopener noreferrer">
                  Ιστολόγιο
                </a>
              )}
            </div>
          )
        }
      </div>

      <div>
        <h3 class="site-footer__title">Χάρτης Ιστότοπου</h3>
        <ul class="site-footer__list">
          {footerLinks.slice(0, 8).map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="site-footer__title">Φιλικές Ιστοσελίδες</h3>
        <ul class="site-footer__list">
          {site.friendlyLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
